<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CopilotCostTracker.ViewModels"
             x:Class="CopilotCostTracker.Views.TrendPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Trend"
             BackgroundColor="{StaticResource SurfaceColor}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- Tab filter -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              ColumnSpacing="8" Padding="0,0,0,12">
            <Button Grid.Column="0" Text="All"
                    Command="{Binding SetTabFilterCommand}" CommandParameter="All"
                    Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='All'}" />
            <Button Grid.Column="1" Text="Today"
                    Command="{Binding SetTabFilterCommand}" CommandParameter="Today"
                    Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Today'}" />
            <Button Grid.Column="2" Text="This week"
                    Command="{Binding SetTabFilterCommand}" CommandParameter="Week"
                    Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Week'}" />
            <Button Grid.Column="3" Text="This month"
                    Command="{Binding SetTabFilterCommand}" CommandParameter="Month"
                    Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Month'}" />
            <Button Grid.Column="4" Text="Custom"
                    Command="{Binding SetTabFilterCommand}" CommandParameter="Custom"
                    Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Custom'}" />
        </Grid>

        <!-- Custom date range picker (only visible when "Custom" tab is active) -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="0,0,0,12"
                                IsVisible="{Binding ActiveTabFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Custom'}">
            <Label Text="From" VerticalOptions="Center" Style="{StaticResource TextTertiaryStyle}" />
            <DatePicker Date="{Binding CustomFromDate}" FontSize="12" />
            <Label Text="To" VerticalOptions="Center" Style="{StaticResource TextTertiaryStyle}" />
            <DatePicker Date="{Binding CustomToDate}" FontSize="12" />
        </HorizontalStackLayout>

        <!-- Chart -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
            <GraphicsView x:Name="ChartView"
                          Margin="8" />
        </Border>

        <!-- Bottom totals -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" Padding="0,12,0,0" ColumnSpacing="12">
            <Border BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="14,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Total tokens" FontSize="11" Style="{StaticResource TextTertiaryStyle}" />
                    <Label FontSize="18" FontAttributes="Bold"
                           TextColor="#5AC87A">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span x:Name="TotalTokensSpan" Text="—" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="14,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Total cost" FontSize="11" Style="{StaticResource TextTertiaryStyle}" />
                    <Label FontSize="18" FontAttributes="Bold"
                           TextColor="#FF6B8A">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span x:Name="TotalCostSpan" Text="—" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
