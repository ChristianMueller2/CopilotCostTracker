<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CopilotCostTracker.ViewModels"
             x:Class="CopilotCostTracker.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource SurfaceColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="0">

            <!-- ── Startup ───────────────────────────────────────────────── -->
            <Label Text="Startup"
                   FontSize="13" FontAttributes="Bold"
                   Style="{StaticResource TextTertiaryStyle}"
                   Margin="0,0,0,10" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="16,14" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Launch at Windows startup"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Switch Grid.Row="0" Grid.Column="1"
                            IsToggled="{Binding AutostartEnabled}"
                            OnColor="{StaticResource AccentGreenColor}"
                            VerticalOptions="Center" />

                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Starts the app minimized to the tray when you sign in to Windows."
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />
                </Grid>
            </Border>

            <!-- ── Notifications ─────────────────────────────────────────── -->
            <Label Text="Notifications"
                   FontSize="13" FontAttributes="Bold"
                   Style="{StaticResource TextTertiaryStyle}"
                   Margin="0,0,0,10" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="16,14" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Enable tray notifications"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Switch Grid.Row="0" Grid.Column="1"
                            IsToggled="{Binding NotificationsEnabled}"
                            OnColor="{StaticResource AccentGreenColor}"
                            VerticalOptions="Center" />

                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Show a balloon tip when a daily or monthly cost limit is reached."
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />
                </Grid>
            </Border>

            <!-- ── Test notification ──────────────────────────────────────── -->
            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="16,14" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Test notification"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Send test"
                            Command="{Binding TestNotificationCommand}"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            TextColor="{StaticResource AccentBlueColor}"
                            BorderColor="{StaticResource AccentBlueColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            FontSize="12"
                            Padding="12,4" />
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Fires a sample balloon tip so you can verify notifications work."
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />
                </Grid>
            </Border>

            <!-- ── Model pricing ─────────────────────────────────────────── -->
            <Label Text="Model pricing"
                   FontSize="13" FontAttributes="Bold"
                   Style="{StaticResource TextTertiaryStyle}"
                   Margin="0,0,0,10" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="16,14" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Edit model prices"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Open →"
                            Command="{Binding GoToPricingCommand}"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            TextColor="{StaticResource AccentBlueColor}"
                            BorderColor="{StaticResource AccentBlueColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            FontSize="12"
                            Padding="12,4" />
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Per-million-token prices for all models. Add custom models or adjust rates without an app update."
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />
                </Grid>
            </Border>

            <!-- ── Cost limits ───────────────────────────────────────────── -->
            <Label Text="Cost limits (USD)"
                   FontSize="13" FontAttributes="Bold"
                   Style="{StaticResource TextTertiaryStyle}"
                   Margin="0,0,0,10" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="16,14" Margin="0,0,0,20">
                <Grid RowDefinitions="Auto,12,Auto,12,Auto,16,Auto,Auto"
                      ColumnDefinitions="*,Auto">

                    <!-- Daily -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Daily limit"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Entry Grid.Row="0" Grid.Column="1"
                           Text="{Binding DailyLimitText}"
                           Placeholder="e.g. 5.00"
                           WidthRequest="100"
                           Keyboard="Numeric"
                           HorizontalTextAlignment="End"
                           BackgroundColor="{StaticResource SurfaceColor}"
                           TextColor="{StaticResource TextPrimaryColor}"
                           PlaceholderColor="{StaticResource TextTertiaryColor}" />

                    <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                             HeightRequest="0.5" Color="{StaticResource BorderColor}" />

                    <!-- Monthly -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Text="Monthly limit"
                           FontSize="14"
                           Style="{StaticResource TextPrimaryStyle}" />
                    <Entry Grid.Row="2" Grid.Column="1"
                           Text="{Binding MonthlyLimitText}"
                           Placeholder="e.g. 20.00"
                           WidthRequest="100"
                           Keyboard="Numeric"
                           HorizontalTextAlignment="End"
                           BackgroundColor="{StaticResource SurfaceColor}"
                           TextColor="{StaticResource TextPrimaryColor}"
                           PlaceholderColor="{StaticResource TextTertiaryColor}" />

                    <Label Grid.Row="3" Grid.ColumnSpan="2"
                           Text=" " HeightRequest="0.5" />

                    <Label Grid.Row="4" Grid.ColumnSpan="2"
                           Text="Leave a field empty to disable that limit. A tray notification is shown once per day / month when the limit is exceeded."
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />

                    <BoxView Grid.Row="5" Grid.ColumnSpan="2"
                             HeightRequest="0.5" Color="{StaticResource BorderColor}" />

                    <!-- Save button -->
                    <Button Grid.Row="6" Grid.ColumnSpan="2"
                            Text="Save limits"
                            Command="{Binding SaveLimitsCommand}"
                            BackgroundColor="{StaticResource AccentBlueColor}"
                            TextColor="White"
                            CornerRadius="8"
                            FontSize="13"
                            Padding="16,8"
                            HorizontalOptions="End"
                            Margin="0,6,0,0" />

                    <!-- Confirmation message -->
                    <Label Grid.Row="7" Grid.ColumnSpan="2"
                           Text="{Binding SaveConfirmation}"
                           FontSize="12"
                           TextColor="{StaticResource AccentGreenColor}"
                           HorizontalOptions="End"
                           IsVisible="{Binding HasSaveConfirmation}"
                           Margin="0,4,0,0" />

                </Grid>
            </Border>

            <!-- ── App version ─────────────────────────────────────────────── -->
            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <HorizontalStackLayout HorizontalOptions="End" Spacing="6">
                    <Label Text="App version"
                           FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}" />
                    <Label Text="{Binding AppVersionText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentBlueColor}" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
