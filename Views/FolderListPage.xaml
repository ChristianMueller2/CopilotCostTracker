<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CopilotCostTracker.ViewModels"
             x:Class="CopilotCostTracker.Views.FolderListPage"
             x:DataType="viewmodels:FolderListViewModel"
             Title="Watched folders"
             BackgroundColor="{StaticResource SurfaceColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="←" Command="{Binding GoBackCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">

        <!-- Folder list / empty state -->
        <ScrollView Grid.Row="0" IsVisible="{Binding HasFolders}">
            <VerticalStackLayout x:Name="FoldersLayout" Spacing="6" />
        </ScrollView>

        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center"
                             Spacing="8" IsVisible="{Binding HasNoFolders}">
            <Label Text="No folders added yet" FontSize="14"
                   HorizontalOptions="Center"
                   Style="{StaticResource TextSecondaryStyle}" />
            <Label Text="Click '＋ Add folder' below to start tracking sessions"
                   FontSize="12" HorizontalOptions="Center"
                   Style="{StaticResource TextTertiaryStyle}" />
        </VerticalStackLayout>

        <!-- Bottom bar: status + prominent add button -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowSpacing="0" ColumnSpacing="12">

            <Label Grid.Column="0"
                   Text="{Binding LastUpdated}"
                   FontSize="12"
                   VerticalOptions="Center"
                   Style="{StaticResource TextTertiaryStyle}" />

            <Button Grid.Column="1"
                    Text="＋  Add folder"
                    Command="{Binding AddFolderCommand}"
                    BackgroundColor="{StaticResource AccentBlueColor}"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="20,10"
                    HeightRequest="44" />
        </Grid>

    </Grid>

</ContentPage>
