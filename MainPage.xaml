<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CopilotCostTracker.ViewModels"
             xmlns:models="clr-namespace:CopilotCostTracker.Models"
             xmlns:views="clr-namespace:CopilotCostTracker.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CopilotCostTracker.MainPage"
             x:DataType="viewmodels:MainViewModel"
             x:Name="Root"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Top bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource SurfaceColor}"
                Padding="16,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Overview"
                       FontSize="16" VerticalOptions="Center"
                       Style="{StaticResource TextPrimaryStyle}" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding LastUpdated}" FontSize="12"
                           Style="{StaticResource TextTertiaryStyle}"
                           VerticalOptions="Center" />
                    <Border StrokeShape="RoundRectangle 20" Padding="8,4"
                            BackgroundColor="#1A7EC636"
                            IsVisible="{Binding IsWatcherActive}">
                        <HorizontalStackLayout Spacing="4">
                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                     Color="{StaticResource AccentGreenColor}"
                                     VerticalOptions="Center" />
                            <Label Text="Live" FontSize="11"
                                   TextColor="{StaticResource AccentGreenColor}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Button Text="↻" WidthRequest="32" HeightRequest="32"
                            CornerRadius="16" FontSize="14"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextSecondaryColor}"
                            Command="{Binding RefreshCommand}" />
                    <!-- Credits / USD toggle -->
                    <Button Command="{Binding ToggleCreditsCommand}"
                            CornerRadius="8" FontSize="11" Padding="10,4"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                            BorderWidth="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowCredits}" Value="True">
                                <Setter Property="Text" Value="Credits" />
                                <Setter Property="TextColor" Value="{StaticResource AccentGreenColor}" />
                                <Setter Property="BorderColor" Value="{StaticResource AccentGreenColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowCredits}" Value="False">
                                <Setter Property="Text" Value="USD" />
                                <Setter Property="TextColor" Value="{StaticResource AccentBlueColor}" />
                                <Setter Property="BorderColor" Value="{StaticResource AccentBlueColor}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ── Scrollable content ──────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- ① Metric cards – row 1: totals -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                    <!-- Total cost / AI credits (switchable) -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Total cost" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding GrandTotalCostUsd, StringFormat='${0:F4}'}"
                                   FontSize="22" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="AI credits" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}"
                                   IsVisible="{Binding ShowCredits}" />
                            <Label Text="{Binding GrandTotalCredits, StringFormat='{0:F2} cr'}"
                                   FontSize="22" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits}" />
                            <Label FontSize="11" Style="{StaticResource TextTertiaryStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TotalSessionCount}" />
                                        <Span Text=" sessions &#183; " />
                                        <Span Text="{Binding TotalFolderCount}" />
                                        <Span Text=" folders" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- AI credits / USD (switchable) -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="AI credits" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding GrandTotalCredits, StringFormat='{0:F2} cr'}"
                                   FontSize="22" Style="{StaticResource TextPrimaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding GrandTotalCostUsd, StringFormat='&#x2248; ${0:F2} USD'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="Total cost" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}"
                                   IsVisible="{Binding ShowCredits}" />
                            <Label Text="{Binding GrandTotalCostUsd, StringFormat='${0:F4}'}"
                                   FontSize="22" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits}" />
                            <Label Text="{Binding GrandTotalCredits, StringFormat='&#x2248; {0:F2} cr'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}"
                                   IsVisible="{Binding ShowCredits}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Output tokens -->
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Output tokens" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}" />
                            <Label Text="{Binding TotalOutputTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                   FontSize="22" Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="total output" FontSize="11"
                                   Style="{StaticResource TextTertiaryStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cache savings -->
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Cache savings" FontSize="12"
                                   Style="{StaticResource TextSecondaryStyle}" />
                            <Label Text="{Binding CacheSavingsUsd, StringFormat='${0:F4}'}"
                                   FontSize="22" Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="{Binding TotalCacheReadTokens, Converter={StaticResource TokensToShortStringConverter}, StringFormat='{0} cached tokens'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ① Metric cards – row 2: token breakdown -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <!-- Input tokens -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#4DA3FF" VerticalOptions="Center" />
                                <Label Text="Input tokens" FontSize="12"
                                       Style="{StaticResource TextSecondaryStyle}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalInputTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                   FontSize="20" Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="{Binding TotalInputCostUsd, StringFormat='${0:F4}'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding TotalInputCredits, StringFormat='{0:F0} cr'}"
                                   FontSize="11" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Output tokens -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#5AC87A" VerticalOptions="Center" />
                                <Label Text="Output tokens" FontSize="12"
                                       Style="{StaticResource TextSecondaryStyle}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalOutputTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                   FontSize="20" Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="{Binding TotalOutputCostUsd, StringFormat='${0:F4}'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding TotalOutputCredits, StringFormat='{0:F0} cr'}"
                                   FontSize="11" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cache tokens -->
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#FFB340" VerticalOptions="Center" />
                                <Label Text="Cached tokens" FontSize="12"
                                       Style="{StaticResource TextSecondaryStyle}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalCacheReadTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                   FontSize="20" Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="{Binding TotalCacheReadCostUsd, StringFormat='${0:F4}'}"
                                   FontSize="11" Style="{StaticResource TextTertiaryStyle}"
                                   IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                            <Label Text="{Binding TotalCacheReadCredits, StringFormat='{0:F0} cr'}"
                                   FontSize="11" TextColor="{StaticResource AccentGreenColor}"
                                   IsVisible="{Binding ShowCredits}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ② Analytics row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- Left: Cost breakdown donut -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Cost breakdown" FontSize="13"
                                   Style="{StaticResource TextPrimaryStyle}" />
                            <GraphicsView x:Name="DonutView"
                                          HeightRequest="140"
                                          HorizontalOptions="Fill" />
                            <!-- Legend -->
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="4">
                                <BoxView Grid.Row="0" Grid.Column="0"
                                         WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#4DA3FF" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Input"
                                       FontSize="11" Style="{StaticResource TextSecondaryStyle}" />
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding TotalInputCostUsd, StringFormat='${0:F4}'}"
                                       FontSize="11" HorizontalOptions="End"
                                       Style="{StaticResource TextTertiaryStyle}"
                                       IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding TotalInputCredits, StringFormat='{0:F0} cr'}"
                                       FontSize="11" HorizontalOptions="End"
                                       TextColor="{StaticResource AccentGreenColor}"
                                       IsVisible="{Binding ShowCredits}" />

                                <BoxView Grid.Row="1" Grid.Column="0"
                                         WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#5AC87A" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Row="1" Grid.Column="1" Text="Output"
                                       FontSize="11" Style="{StaticResource TextSecondaryStyle}" />
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding TotalOutputCostUsd, StringFormat='${0:F4}'}"
                                       FontSize="11" HorizontalOptions="End"
                                       Style="{StaticResource TextTertiaryStyle}"
                                       IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding TotalOutputCredits, StringFormat='{0:F0} cr'}"
                                       FontSize="11" HorizontalOptions="End"
                                       TextColor="{StaticResource AccentGreenColor}"
                                       IsVisible="{Binding ShowCredits}" />

                                <BoxView Grid.Row="2" Grid.Column="0"
                                         WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#FFB340" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Row="2" Grid.Column="1" Text="Cache read"
                                       FontSize="11" Style="{StaticResource TextSecondaryStyle}" />
                                <Label Grid.Row="2" Grid.Column="2"
                                       Text="{Binding TotalCacheReadCostUsd, StringFormat='${0:F4}'}"
                                       FontSize="11" HorizontalOptions="End"
                                       Style="{StaticResource TextTertiaryStyle}"
                                       IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                <Label Grid.Row="2" Grid.Column="2"
                                       Text="{Binding TotalCacheReadCredits, StringFormat='{0:F0} cr'}"
                                       FontSize="11" HorizontalOptions="End"
                                       TextColor="{StaticResource AccentGreenColor}"
                                       IsVisible="{Binding ShowCredits}" />

                                <BoxView Grid.Row="3" Grid.Column="0"
                                         WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="#FF6B8A" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Row="3" Grid.Column="1" Text="Cache write"
                                       FontSize="11" Style="{StaticResource TextSecondaryStyle}" />
                                <Label Grid.Row="3" Grid.Column="2"
                                       Text="{Binding TotalCacheWriteCostUsd, StringFormat='${0:F4}'}"
                                       FontSize="11" HorizontalOptions="End"
                                       Style="{StaticResource TextTertiaryStyle}"
                                       IsVisible="{Binding ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                <Label Grid.Row="3" Grid.Column="2"
                                       Text="{Binding TotalCacheWriteCredits, StringFormat='{0:F0} cr'}"
                                       FontSize="11" HorizontalOptions="End"
                                       TextColor="{StaticResource AccentGreenColor}"
                                       IsVisible="{Binding ShowCredits}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Right: Cost by model bars -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Cost by model" FontSize="13"
                                   Style="{StaticResource TextPrimaryStyle}" />
                            <VerticalStackLayout x:Name="ModelBarsLayout"
                                                 BindableLayout.ItemsSource="{Binding CostByModel}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModelCostItem">
                                        <Grid ColumnDefinitions="90,*,58" ColumnSpacing="8" Margin="0,0,0,6">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Model}"
                                                   FontSize="11" LineBreakMode="TailTruncation"
                                                   Style="{StaticResource TextSecondaryStyle}"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1" StrokeShape="RoundRectangle 3"
                                                    HeightRequest="6" VerticalOptions="Center"
                                                    BackgroundColor="{StaticResource BorderColor}">
                                                <BoxView HeightRequest="6" CornerRadius="3"
                                                         Color="{StaticResource AccentBlueColor}"
                                                         HorizontalOptions="Start"
                                                         WidthRequest="{Binding BarWidthPixels}" />
                                            </Border>
                                            <Label Grid.Column="2"
                                                   Text="{Binding CostUsd, StringFormat='${0:F2}'}"
                                                   FontSize="11" HorizontalOptions="End"
                                                   Style="{StaticResource TextSecondaryStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ③ Mini trend chart -->
                <Border StrokeShape="RoundRectangle 10" Padding="14,12"
                        BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cumulative trend" FontSize="13"
                               Style="{StaticResource TextPrimaryStyle}" />
                        <GraphicsView x:Name="MiniChartView"
                                      HeightRequest="130"
                                      HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <!-- ③b Estimation setting -->
                <Border StrokeShape="RoundRectangle 8" Padding="12,8"
                        BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Include estimated sessions"
                                   FontSize="13"
                                   Style="{StaticResource TextPrimaryStyle}" />
                            <Label Text="Eclipse and Copilot CLI sessions without exact token data are marked &#x2248; and included in cost totals"
                                   FontSize="11"
                                   Style="{StaticResource TextTertiaryStyle}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding EnableEclipseEstimation, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ③b Token coverage info hint (dismissible) -->
                <Border IsVisible="{Binding ShowTokenInfoHint}"
                        StrokeShape="RoundRectangle 8" Padding="12,10"
                        BackgroundColor="#1A4DA3FF"
                        Stroke="#4DA3FF" StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Icon -->
                        <Label Grid.Column="0" Text="&#x2139;" FontSize="16"
                               TextColor="#4DA3FF" VerticalOptions="Start" />
                        <!-- Text -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Token coverage differs by IDE"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="#4DA3FF" />
                            <Label FontSize="11" Style="{StaticResource TextSecondaryStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="&#x2022; " />
                                        <Span Text="Copilot (VS Extension)" FontAttributes="Bold" />
                                        <Span Text=" — logs all token types: input, output, cache read &amp; write." />
                                        <Span Text="&#10;&#x2022; " />
                                        <Span Text="Copilot CLI" FontAttributes="Bold" />
                                        <Span Text=" — output tokens are exact; input tokens per turn are not logged and are estimated " />
                                        <Span Text="&#x2248;" FontAttributes="Bold" />
                                        <Span Text=" from context size. Turns after the last compaction are unaccounted for (typically +20&#x2013;40%)." />
                                        <Span Text="&#10;&#x2022; " />
                                        <Span Text="VS Code" FontAttributes="Bold" />
                                        <Span Text=" — only output (completion) tokens are stored; input and cache tokens are not available." />
                                        <Span Text="&#10;&#x2022; " />
                                        <Span Text="Eclipse" FontAttributes="Bold" />
                                        <Span Text=" — no token data at all; input &amp; output are estimated " />
                                        <Span Text="&#x2248;" FontAttributes="Bold" />
                                        <Span Text=" from message length (chars &#247; 4)." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <!-- Dismiss button -->
                        <Button Grid.Column="2" Text="&#x2715;"
                                FontSize="13"
                                WidthRequest="28" HeightRequest="28"
                                CornerRadius="14"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextTertiaryColor}"
                                VerticalOptions="Start"
                                Command="{Binding DismissTokenInfoHintCommand}" />
                    </Grid>
                </Border>

                <!-- ④ Filter bar -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="All"
                            Command="{Binding SetTabFilterCommand}"
                            CommandParameter="All"
                            Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='All'}" />
                    <Button Text="Today"
                            Command="{Binding SetTabFilterCommand}"
                            CommandParameter="Today"
                            Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Today'}" />
                    <Button Text="This week"
                            Command="{Binding SetTabFilterCommand}"
                            CommandParameter="Week"
                            Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Week'}" />
                    <Button Text="This month"
                            Command="{Binding SetTabFilterCommand}"
                            CommandParameter="Month"
                            Style="{Binding ActiveTabFilter, Converter={StaticResource TabFilterStyleConverter}, ConverterParameter='Month'}" />
                    <SearchBar Placeholder="Filter by repo or model…"
                               Text="{Binding FilterText}"
                               HorizontalOptions="Fill"
                               BackgroundColor="{StaticResource SurfaceSecondaryColor}" />
                </HorizontalStackLayout>

                <!-- Sessions header -->
                <Grid ColumnDefinitions="*,80,68,68,68,72" Padding="8,0">
                    <Label Grid.Column="0" Text="Repository / model" FontSize="11" Style="{StaticResource TextTertiaryStyle}" />
                    <Label Grid.Column="1" Text="Time"       FontSize="11" HorizontalOptions="End" Style="{StaticResource TextTertiaryStyle}" />
                    <Label Grid.Column="2" Text="Input"      FontSize="11" HorizontalOptions="End" Style="{StaticResource TextTertiaryStyle}" />
                    <Label Grid.Column="3" Text="Output"     FontSize="11" HorizontalOptions="End" Style="{StaticResource TextTertiaryStyle}" />
                    <Label Grid.Column="4" Text="Cache"      FontSize="11" HorizontalOptions="End" Style="{StaticResource TextTertiaryStyle}" />
                    <Label Grid.Column="5" Text="Total"      FontSize="11" HorizontalOptions="End" Style="{StaticResource TextTertiaryStyle}" />
                </Grid>

                <!-- Sessions list -->
                <CollectionView ItemsSource="{Binding FilteredSessions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CopilotSession">
                            <Border Margin="0,0,0,4"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource SurfaceSecondaryColor}"
                                    Padding="8,10">
                                <Grid ColumnDefinitions="*,80,68,68,68,72"
                                      VerticalOptions="Center">

                                    <!-- Col 0: repo / model -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Repository}" FontSize="13"
                                                   Style="{StaticResource TextPrimaryStyle}" />
                                            <Label Text="{Binding Branch}" FontSize="11"
                                                   Style="{StaticResource TextTertiaryStyle}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="4">
                                            <Border StrokeShape="RoundRectangle 20" Padding="5,2"
                                                    BackgroundColor="{StaticResource SurfaceSecondaryColor}">
                                                <Label Text="{Binding Model}" FontSize="11"
                                                       Style="{StaticResource TextSecondaryStyle}" />
                                            </Border>
                                            <Label Text="{Binding SourceFolder, Converter={StaticResource PathToNameConverter}}"
                                                   FontSize="11" LineBreakMode="TailTruncation"
                                                   Style="{StaticResource TextTertiaryStyle}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Col 1: time -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding StartTime, StringFormat='{0:dd.MM.yyyy}'}"
                                               FontSize="11" HorizontalOptions="End"
                                               Style="{StaticResource TextPrimaryStyle}" />
                                        <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                               FontSize="11" HorizontalOptions="End"
                                               Style="{StaticResource TextTertiaryStyle}" />
                                    </VerticalStackLayout>

                                    <!-- Col 2: Input -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End">
                                        <Label Text="{Binding Usage.InputTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                               FontSize="12" HorizontalOptions="End"
                                               Style="{StaticResource TextPrimaryStyle}" />
                                        <Label Text="{Binding InputCostUsd, StringFormat='${0:F2}'}"
                                               FontSize="11" HorizontalOptions="End"
                                               Style="{StaticResource TextTertiaryStyle}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="{Binding InputCredits, StringFormat='{0:F0} cr'}"
                                               FontSize="11" HorizontalOptions="End"
                                               TextColor="{StaticResource AccentGreenColor}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits}" />
                                    </VerticalStackLayout>

                                    <!-- Col 3: Output -->
                                    <VerticalStackLayout Grid.Column="3" Spacing="1" HorizontalOptions="End">
                                        <Label Text="{Binding Usage.OutputTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                               FontSize="12" HorizontalOptions="End"
                                               Style="{StaticResource TextPrimaryStyle}" />
                                        <Label Text="{Binding OutputCostUsd, StringFormat='${0:F2}'}"
                                               FontSize="11" HorizontalOptions="End"
                                               Style="{StaticResource TextTertiaryStyle}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="{Binding OutputCredits, StringFormat='{0:F0} cr'}"
                                               FontSize="11" HorizontalOptions="End"
                                               TextColor="{StaticResource AccentGreenColor}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits}" />
                                    </VerticalStackLayout>

                                    <!-- Col 4: Cache -->
                                    <VerticalStackLayout Grid.Column="4" Spacing="1" HorizontalOptions="End">
                                        <Label Text="{Binding Usage.CacheReadTokens, Converter={StaticResource TokensToShortStringConverter}}"
                                               FontSize="12" HorizontalOptions="End"
                                               Style="{StaticResource TextPrimaryStyle}" />
                                        <Label Text="{Binding CacheReadCostUsd, StringFormat='${0:F2}'}"
                                               FontSize="11" HorizontalOptions="End"
                                               Style="{StaticResource TextTertiaryStyle}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="{Binding CacheReadCredits, StringFormat='{0:F0} cr'}"
                                               FontSize="11" HorizontalOptions="End"
                                               TextColor="{StaticResource AccentGreenColor}"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits}" />
                                    </VerticalStackLayout>

                                    <!-- Col 5: Total -->
                                    <VerticalStackLayout Grid.Column="5" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding TotalCostUsd, StringFormat='${0:F4}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource AccentGreenColor}"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="{Binding TotalCredits, StringFormat='{0:F0} cr'}"
                                               FontSize="13"
                                               TextColor="{StaticResource AccentGreenColor}"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.ShowCredits}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                             Spacing="8" Padding="0,40">
                            <Label Text="No sessions found" FontSize="15"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource TextSecondaryStyle}" />
                            <Label Text="Add a folder to get started" FontSize="12"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource TextTertiaryStyle}" />
                            <Button Text="Add folder"
                                    Command="{Binding GoToFoldersCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

